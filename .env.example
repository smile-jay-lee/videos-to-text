# ========================================
# 视频转文字系统 - 环境变量配置示例
# ========================================
# 复制此文件为 .env 并根据实际情况修改配置

# ========== API 配置 ==========
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========== Whisper 配置 ==========
# 运行模式：
#   - local: 本地模式（性能优先，适合有充足内存和GPU的环境）
#   - server: 服务器模式（内存优化，适合低配服务器）
WHISPER_MODE=local